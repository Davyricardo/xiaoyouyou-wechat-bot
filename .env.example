# ===== 部署基础 =====
XYY_BASE=/opt/xiaoyouyou
XYY_HOME=/opt/xiaoyouyou
WX_API_BASE=http://127.0.0.1:6174
# 微信容器 API token（必填，自己生成：openssl rand -hex 32）
AGENT_WECHAT_TOKEN=

# ===== 群与身份 =====
# 授权群 ID 和群名写在 bot-config.json；这里可覆盖昵称
SPLATOON_BOT_NICK=小鱿鱿
# 留空则使用 bot-config.json 的 chatId
SPLATOON_CHAT_ID=

# ===== 状态与事件 =====
# SPLATOON_STATE_FILE=$HOME/.local/state/splatoon-bridge/state.json
# XYY_EVENTS_FILE=$HOME/.local/state/splatoon-bridge/recovery-events.jsonl

# ===== 启动宽限与补处理 =====
XYY_STARTUP_GRACE_MS=30000
XYY_BACKLOG_MS=1800000
XYY_POLL_STUCK_LIMIT=10

# ===== 自动聊天（LLM）=====
# off / all / admin
XYY_LLM=off
XYY_LLM_URL=http://127.0.0.1:3430/v1/chat/completions
XYY_LLM_MODEL=workbuddy/deepseek-v4.1-flash
XYY_LLM_KEY=
# 允许闲聊的用户，逗号分隔；留空=所有人
XYY_LLM_USERS=
# 人设文件（默认 private/persona.md）
XYY_LLM_PERSONA_FILE=
# 对话记忆开关与目录
XYY_LLM_MEMORY=1
XYY_LLM_MEMORY_DIR=
# 主动插话
XYY_LLM_CHIME=0
XYY_LLM_CHIME_DAILY=12
XYY_LLM_CHAT_GAP_MS=1200000
XYY_LLM_USER_GAP_MS=30000
XYY_LLM_MAX_CHARS=300
XYY_LLM_TIMEOUT_MS=30000
XYY_LLM_FAIL_LIMIT=3
XYY_LLM_PAUSE_MS=600000
# 联网搜索（可选）
XYY_LLM_SEARCH=0
XYY_LLM_SEARCH_DAILY=20
XYY_LLM_SEARCH_TIMEOUT_MS=15000

# ===== 保活 =====
XYY_MEM_LIMIT_MB=600
XYY_RECYCLE_GAP_MS=2700000
XYY_RECYCLE_REQUEST_GAP_MS=900000
XYY_RESTART_WAIT_MS=420000
# 1 = 只判定不执行（演练）
XYY_DRY=
