# ===== 部署基础 =====
XYY_BASE=/opt/xiaoyouyou
XYY_HOME=/opt/xiaoyouyou
WX_API_BASE=http://127.0.0.1:6174
# 微信容器 API token（必填，自己生成：openssl rand -hex 32）
AGENT_WECHAT_TOKEN=

# ===== 群与身份 =====
# 授权群 ID 和群名写在 bot-config.json；这里可覆盖昵称
SPLATOON_BOT_NICK=小鱿鱿
# 留空则使用 bot-config.json 的 chatId
SPLATOON_CHAT_ID=
# 机器人账号 wxid。留空则首次登录时由 WebUI 自动写入 private/expected-user.txt，
# 之后换号会被恢复流程识别为异常。
# XYY_EXPECTED_USER=wxid_xxxxxxxxxxxx_xxxx

# ===== 状态与事件 =====
# SPLATOON_STATE_FILE=$HOME/.local/state/splatoon-bridge/state.json
# XYY_EVENTS_FILE=$HOME/.local/state/splatoon-bridge/recovery-events.jsonl

# ===== 启动宽限与补处理 =====
XYY_STARTUP_GRACE_MS=30000
XYY_BACKLOG_MS=1800000
XYY_POLL_STUCK_LIMIT=10

# ===== 自动聊天（LLM）=====
# LLM 配置独立在 private/llm.env（WebUI「聊天」页会改写它；env-config 合并 private/*.env）。
# 不要把 XYY_LLM* 重复写在这里：两个文件都写时按文件名排序，llm.env 会覆盖本文件。
# 详见 private/llm.env 与 README「自动聊天」。

# ===== 保活 =====
XYY_MEM_LIMIT_MB=600
XYY_RECYCLE_GAP_MS=2700000
XYY_RECYCLE_REQUEST_GAP_MS=900000
XYY_RESTART_WAIT_MS=420000
# 1 = 只判定不执行（演练）
XYY_DRY=
